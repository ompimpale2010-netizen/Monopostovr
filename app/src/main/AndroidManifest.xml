<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay window that hosts the VR SBS renderer -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service so capture keeps running when MainActivity finishes -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required on API 34+ for a foreground service that uses MediaProjection.
         Harmless to declare even though minSdk is 30. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Deliberately NOT requested: INTERNET, CAMERA, MICROPHONE, LOCATION,
         READ_CONTACTS, SMS, STORAGE. This app touches none of that. -->

    <uses-feature android:name="android.hardware.opengles.aep" android:required="false" />

<queries>
    <package android:name="com.gabama.monopostolite" />
</queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_camera"
        android:theme="@style/Theme.MonopostoVRMirror"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType=mediaProjection is required by Android 14 (API 34)
             and is good practice even though minSdk is 30. -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
